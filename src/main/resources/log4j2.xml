<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

	<Appenders>

		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{HH:mm:ss} %-5level [%t] %c{1} - %msg%n" />
		</Console>

		<RollingFile
			name="File"
			fileName="logs/framework.log"
			filePattern="logs/framework-%d{yyyy-MM-dd}-%i.log.gz">

			<PatternLayout>
				<Pattern>
					%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n
				</Pattern>
			</PatternLayout>

			<Policies>
				<SizeBasedTriggeringPolicy size="10 MB" />
			</Policies>

			<DefaultRolloverStrategy max="5" />

		</RollingFile>

	</Appenders>

	<Loggers>

		<Root level="INFO">
			<AppenderRef ref="Console" />
			<AppenderRef ref="File" />
		</Root>

	</Loggers>

</Configuration>
